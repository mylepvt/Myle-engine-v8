# Production frontend — build Vite SPA, serve with nginx (+ API proxy)
FROM node:22-bookworm-slim AS builder

WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci --no-audit --no-fund
COPY . .

# Empty string = same-origin (nginx proxies /api/ to backend)
ARG VITE_API_URL=""
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build

# ── Runtime ──────────────────────────────────────────────────────────────────
FROM nginx:1.27-alpine

COPY --from=builder /app/dist /usr/share/nginx/html

# $BACKEND_URL is substituted at container startup via the envsubst pass that
# the nginx official image applies to every file in /etc/nginx/templates/.
COPY nginx.conf.template /etc/nginx/templates/default.conf.template

ENV BACKEND_URL=http://localhost:8000

EXPOSE 80
# nginx official image runs envsubst on /etc/nginx/templates/*.template automatically
CMD ["nginx", "-g", "daemon off;"]
